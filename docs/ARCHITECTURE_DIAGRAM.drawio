          <mxGeometry x="1000" y="80" width="280" height="520" as="geometry" />
        </mxCell>

        <mxCell id="agent1" value="1. Triage Agent&#xa;- Severity (Critical/High/Med/Low)&#xa;- Priority Assessment&#xa;- Component Classification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=8;" vertex="1" parent="orchestrator">
