# =====================================================================
# Intelligent Bug Diagnosis Platform with Fix Recommendation Assistance
# Environment Configuration Template
# =====================================================================

# Application Configuration
APP_NAME="Intelligent Bug Diagnosis Platform with Fix Recommendation Assistance"
APP_ENV="development"
DEBUG=True
API_PREFIX="/api"

# Security & JWT Authentication
# Generate a secure secret in production (e.g., via `openssl rand -hex 32`)
SECRET_KEY="intelligent-bug-diagnosis-platform-dev-secret-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local development)
DATABASE_URL="sqlite:///./bug_platform.db"

# Vector Database (ChromaDB persistent directory)
CHROMA_PERSIST_DIRECTORY="./chroma_db"
CHROMA_COLLECTION_NAME="historical_defects"

# Embedding Model Configuration
# Uses sentence-transformers all-MiniLM-L6-v2 by default (free, fast, local)
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Duplicate Detection Thresholds
SIMILARITY_THRESHOLD_DUPLICATE=0.85
SIMILARITY_THRESHOLD_RELATED=0.65

# Optional AI / LLM Provider Keys
# The platform includes an intelligent local heuristic engine.
# If an API key is provided below, agents will use the external LLM;
# otherwise, they smoothly use the local fallback engine without errors.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="heuristic"  # options: "heuristic", "gemini", "openai"
