<mxfile host="app.diagrams.net" modified="2026-09-18T12:00:00.000Z" agent="Antigravity" version="21.0.0" type="device">
  <diagram id="intelligent-bug-diagnosis-arch" name="System Architecture">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- User Layer -->
        <mxCell id="user" value="Developer / User&#xa;(Web Browser)" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="80" height="90" as="geometry" />
        </mxCell>

        <!-- Frontend -->
        <mxCell id="frontend" value="Frontend (React + Vite + Tailwind)&#xa;- Landing &amp; Auth (JWT)&#xa;- Dashboard &amp; Bug History&#xa;- Bug Submission (.txt/.log upload)&#xa;- Structured 6-Section Diagnosis UI&#xa;- Knowledge Base Explorer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="190" y="270" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Backend API Gateway -->
        <mxCell id="backend" value="FastAPI Backend Gateway&#xa;- REST API Router (/bugs, /auth, /health)&#xa;- Multipart File Parser &amp; Validator&#xa;- JWT Authentication Service&#xa;- Agent Orchestration Dispatcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontStyle=0" vertex="1" parent="1">
          <mxGeometry x="460" y="270" width="220" height="150" as="geometry" />
        </mxCell>

        <!-- Storage Layer -->
        <mxCell id="sqlite" value="SQLite Database (SQLAlchemy)&#xa;- Users (bcrypt credentials)&#xa;- Bug Reports&#xa;- Structured Agent Diagnoses" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;align=center;" vertex="1" parent="1">
          <mxGeometry x="475" y="470" width="190" height="110" as="geometry" />
        </mxCell>

        <!-- Datasets & Vector DB -->
        <mxCell id="datasets" value="Historical Defect Repositories&#xa;- Mozilla Dataset (Bugzilla)&#xa;- Apache Dataset (Jira)&#xa;- Eclipse Dataset (Bugzilla)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pipeline" value="Ingestion &amp; Chunking Pipeline&#xa;- Column Standardization&#xa;- Text Cleaning &amp; Deduplication&#xa;- Semantic Chunking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;" vertex="1" parent="1">
          <mxGeometry x="740" y="170" width="200" height="70" as="geometry" />
        </mxCell>

